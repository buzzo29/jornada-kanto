/* ============================================================================
   REGRAS DO FIRESTORE

   ESTE ARQUIVO E A FONTE DA VERDADE. Desde 30/08/2026 o firebase.json tem secao "firestore", e
   o `firebase deploy` publica estas regras junto com functions e hosting. Editar no console e
   editar do lado errado: o proximo deploy sobrescreve.

   PUBLICAR SUBSTITUI, NAO MESCLA. Antes disto ser ligado ao deploy, o arquivo passou anos
   parado -- 47 linhas contra 117 no ar -- e publica-lo teria APAGADO da producao a trava dos
   campos de especialidade (sem ela, uma linha no console declara o jogador especialista em todos
   os tipos), a trava do ranking da Trainers League, os matchLogs, os neighborhoodGyms e o
   leagueTypes fechado. Foi reescrito a partir do que estava no ar antes de ligar.

   Se alguem mexer no console mesmo assim, o jeito de nao perder e ler as regras no ar
   (`firebase_get_security_rules` pelo MCP) e trazer pra ca ANTES do proximo deploy.
   ============================================================================ */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================================
    // O CONVIDADO (23/09/2026) -- quem entrou SEM criar conta, pela sessao anonima do Firebase.
    //
    // ELE E UM `request.auth` DE VERDADE: tem uid, tem documento em users/{uid}, e passa em
    // `request.auth != null` -- que era, ate aqui, a UNICA pergunta que estas regras faziam. Ou
    // seja: ligar a sessao anonima, sozinho, daria a ele escrita em TUDO que era "de qualquer
    // logado" -- a agenda da Liga, o chaveamento, os inscritos.
    //
    // ⚠️ E BLOQUEAR OS BOTOES NO CLIENTE NAO RESOLVE, porque a inscricao da Liga Classica e
    // ESCRITA DIRETA DO CLIENTE (o `registerForLeague` mora no index.html, nao nas functions --
    // ver o CLAUDE.md). Um convidado com o console aberto se inscreveria, e o chaveamento passaria
    // a ter uma conta que some quando ele limpar o navegador. A trava da Liga so pode estar AQUI.
    //
    // O `sign_in_provider` do token diz como a pessoa entrou, e pra sessao anonima ele vale
    // exatamente 'anonymous'. Ele NAO e escrito pelo cliente: quem o emite e o proprio Firebase
    // Auth -- e e por isso que ele serve de trava, ao contrario de um campo do documento.
    //
    // ⚠️ SO A ESCRITA E FECHADA. Ler continua livre pra ele: o pedido e que o convidado "veja o
    // que e" e nao jogue, e um ranking que ele nao consegue LER nao teria como ser mostrado.
    // ============================================================================
    function cadastrado() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    // usuários e seus saves -- só o próprio dono acessa
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // ESCRITA: o dono escreve no próprio documento, MENOS nos campos de PRÊMIO e de especialidade.
      // Esses campos só as Cloud Functions gravam (o Admin SDK ignora estas regras): as especialidades
      // pela syncTrainerSpecialties, e rareCandies pela Torre -- doce contado no cliente seria nível de graça,
      // porque a especialidade dá +1% em todos os atributos e vale NAS LIGAS -- se o cliente pudesse
      // escrever, bastava uma linha no console pra se declarar especialista em todos os tipos.
      // Em 03/09/2026 entraram os itens: inventario (o que a pessoa comprou), awakeningUntil (a
      // imunidade a sono, com hora pra acabar) e pocaoArmada. Sao efeito de jogo comprado com
      // moeda -- cliente escrevendo qualquer um deles e item infinito, e o Despertar infinito
      // desliga um golpe do jogo inteiro. Quem escreve e o buyItem/useItem.
      // 'moedas' entrou em 02/09/2026 pelo mesmo motivo elevado ao quadrado: moeda é poder de compra,
      // e o que ela compra hoje é RE-SORTEIO do encontro selvagem. Cliente escrevendo moeda é shiny à
      // vontade -- exatamente a artimanha que a semente do encontro (ver goToWildEncounter) fecha.
      // Quem paga é o claimJourneyCoins e quem cobra é o rerollWildOffer.
      // 'rerollsPorSave' entrou em 11/09/2026 com o TETO de re-sorteios por save, e ele NÃO podia
      // morar no save: o documento do save é livre pro dono (ver a regra logo abaixo), e um teto que
      // o próprio jogador zera não é teto. O 'wildRerolls' do save se dá ao luxo de ser livre porque
      // mentir nele não paga -- ele alimenta a SEMENTE, então um re-sorteio barato devolve a MESMA
      // oferta. Mentir no TOTAL paga: compra re-sorteio a mais. Por isso ele está aqui, com as
      // moedas, e quem escreve é o rerollWildOffer.
      // O resto do documento (nome, pokédex, conquistas) continua livre pro dono como sempre foi.
      // 'achievementsPaid' entrou em 16/09/2026 com as moedas das conquistas, e a trava importa
      // pelo lado que NAO e obvio: escrever pra MAIS ali nao paga nada (o servidor so paga o que
      // esta ganho de verdade), mas ZERAR a lista pelo console faria o bolo inteiro das 69 ficar
      // resgatavel de novo, quantas vezes quisessem. Quem escreve e o claimAchievementCoins.
      // 'ilhasJogadas' entrou em 21/09/2026 com o monitor das Ilhas Laranja. Ele nao da poder de
      // compra nenhum -- mentir nele nao compra nada --, e mesmo assim esta aqui: um contador que
      // o proprio jogador escreve nao mede nada, e a METRICA e o motivo dele existir. Quem escreve
      // e o registerIslandPlay. E a mesma licao do registrantCount da Liga Classica.
      // 'admin' entrou em 12/09/2026 com o painel de treinadores. Ele NAO podia ser um campo livre:
      // quem o tem consegue ler o save de TODO MUNDO pela adminListTrainers, entao um campo que o
      // proprio jogador escreve seria uma linha no console pra ver a conta alheia. Ele so existe
      // aqui e no console do Firebase -- nem as Cloud Functions o escrevem.
      allow write: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['specialties', 'specialtyCounts', 'specialtyCounted', 'rareCandies', 'moedas', 'inventario', 'equipados', 'rerollsPorSave', 'admin', 'achievementsPaid', 'ilhasJogadas']);
      // criação do documento: não há resource.data pra comparar, então checa direto que os campos
      // protegidos não vêm no payload inicial
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['specialties', 'specialtyCounts', 'specialtyCounted', 'rareCandies', 'moedas', 'inventario', 'equipados', 'rerollsPorSave', 'admin', 'achievementsPaid', 'ilhasJogadas']);
      match /saves/{saveId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    // ranking global de campeões e agenda da Liga -- continua liberado pra qualquer logado ESCREVER
    // (a Liga Clássica ainda depende de escrita cooperativa do cliente aqui -- ver mais abaixo).
    // A ÚNICA exceção é o ranking da Trainers League: como ela virou avanço 100% pela Cloud Function
    // (ver trainersLeagueCycles), o cliente nunca mais precisa gravar aí -- trava específica, sem
    // afetar o resto da coleção que a Liga Clássica ainda usa
    // ⚠️ E DESDE 23/09/2026 o CONVIDADO nao escreve aqui (ver `cadastrado()` la em cima): esta e a
    // AGENDA da Liga Classica, e ela e escrita pelo cliente -- um convidado poria um ciclo la.
    match /leagues/{document} {
      allow read: if request.auth != null;
      allow write: if cadastrado() && document != 'champions_alltime_trainers_league';
    }
    // configuração das Ligas customizadas -- o cliente NUNCA escreve aqui (só lê, pra listar as ligas
    // disponíveis pra todo mundo); criação/edição é sempre manual, direto no console do Firebase.
    // Travado de verdade agora -- nenhuma função do jogo precisa de escrita aqui
    match /leagueTypes/{typeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // detalhe de cada ciclo da Liga (chaveamentos) -- continua liberado pra qualquer logado: múltiplos
    // clientes legitimamente ajudam a avançar esse documento compartilhado (não tem um "dono" único).
    // Fechar essa parte de vez exigiria tirar a escrita do cliente por completo e depender só da Cloud
    // Function -- decisão em aberto, não uma correção de baixo risco como as outras
    // ⚠️ A ESCRITA AQUI E O CHAVEAMENTO da Classica, e ela e cooperativa entre clientes -- por isso
    // ela continua aberta. O que mudou em 23/09/2026 e que o CONVIDADO fica de fora: ele nao
    // disputa a liga, entao nao tem por que mexer no chaveamento de quem disputa.
    match /leagueCycles/{cycleId} {
      allow read: if request.auth != null;
      allow write: if cadastrado();
      // cada inscrito só pode escrever no PRÓPRIO registro -- o id do documento é o uid, mas passado
      // por sanitizeForDocId (que deixa em minúsculo) antes de virar o nome do documento, por isso o
      // .lower() aqui -- sem isso, a comparação direta falharia pra qualquer uid com letra maiúscula
      match /registrants/{registrantId} {
        allow read: if request.auth != null;
        allow write: if cadastrado() && registrantId == request.auth.uid.lower();
      }
      // logs de batalha extraídos das partidas (formato novo) -- só o servidor grava, todo mundo lê
      match /matchLogs/{logId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // detalhe de cada ciclo da Trainers League (chaveamento, rodadas) -- diferente da Liga Clássica,
    // AQUI dá pra travar de vez: mapeei toda escrita do cliente nesse documento (trainersLeagueEnsureCycleDoc,
    // trainersLeagueClaim, trainersLeagueDoLock, trainersLeagueAdvanceRounds) e nenhuma delas é uma
    // ação legítima de um jogador específico -- são todas parte do sistema de "avanço cooperativo" que
    // o cliente não faz mais (só a Cloud Function avança, via Admin SDK, que ignora essa regra).
    // Fecha de vez a brecha de qualquer um reescrever o chaveamento inteiro ou se declarar campeão à força
    match /trainersLeagueCycles/{cycleId} {
      allow read: if request.auth != null;
      allow write: if false;
      // aqui o id do documento é o uid SEM nenhuma transformação -- comparação direta, sem .lower()
      match /registrants/{registrantId} {
        allow read: if request.auth != null;
        allow write: if cadastrado() && registrantId == request.auth.uid;
      }
      // escolha de terreno do mandante por rodada -- 1 doc por jogador (picks.{roundIndex} = terrainId)
      match /terrainPicks/{pickerId} {
        allow read: if request.auth != null;
        allow write: if cadastrado() && pickerId == request.auth.uid;
      }
      // troca de time por rodada -- 1 doc por jogador (overrides.{roundIndex} = código do time)
      match /teamPicks/{pickerId} {
        allow read: if request.auth != null;
        allow write: if cadastrado() && pickerId == request.auth.uid;
      }
      // logs de batalha extraídos das partidas (formato novo) -- só o servidor grava, todo mundo lê
      match /matchLogs/{logId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Ginásio do Bairro (feature em teste) -- quem é o líder de cada bairro curado. Só o servidor
    // escreve (via challengeNeighborhoodGym, que resolve a disputa em transação); o cliente nunca
    // reporta resultado nem troca o líder direto -- exatamente pra evitar alguém se autoproclamar
    // líder sem realmente vencer. Leitura aberta pra qualquer logado ver quem lidera onde
    match /neighborhoodGyms/{gymId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /challengeLogs/{logId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
      // melhor marca histórica de cada treinador nesse ginásio -- só lida pela Cloud Function do
      // ranking (getNeighborhoodGymLeaderboard, que já soma o líder atual ao vivo); não precisa de
      // leitura direta do cliente
      match /leaderRecords/{uid} {
        allow read, write: if false;
      }
    }
    // índice reverso uid_slot -> qual ginásio esse time defende. Só o servidor escreve; leitura só
    // pro próprio dono (é informação sobre os times DELE, não precisa ser pública como o ginásio em si)
    match /neighborhoodGymActiveDefenses/{docId} {
      allow read: if request.auth != null && docId.split('_')[0] == request.auth.uid;
      allow write: if false;
    }

    // BOSS DE DOMINGO -- raide global (em avaliacao, so contas userTest). Leitura livre pra
    // qualquer logado, escrita NEGADA a todos, inclusive ao dono da conta: quem escreve e a Cloud
    // Function pelo Admin SDK. E o oposto de users/{uid}, onde o jogador so estraga o que e dele --
    // aqui uma escrita solta mataria o Mew do jogo inteiro com um hp:0 escrito na mao.
    // Hoje nada do cliente le este documento direto (a tela passa pelo getSundayBoss), mas a regra
    // fica explicita: sem ela vale o "negado por padrao", que protege igual mas nao explica nada.
    match /globalBoss/{bossId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /players/{playerId} {
        allow read: if request.auth != null && request.auth.uid == playerId;
        allow write: if false;
      }
    }

    // O RANKING DA PESCARIA (20/09/2026). Um documento por jogador, com o MELHOR resultado dele.
    // ESCRITA NEGADA A TODOS, inclusive ao dono: pontuacao e placar publico, e uma linha no console
    // poria qualquer numero no topo. Quem grava e o `submitFishingScore` pelo Admin SDK, e ele so
    // sobe o recorde -- nunca baixa.
    // A leitura e livre pra quem esta logado porque o ranking E publico; hoje a tela passa pelo
    // `getFishingRanking` (que ja ordena e marca quem e voce), mas a regra fica explicita: sem ela
    // vale o "negado por padrao", que protege igual e nao explica nada.
    match /fishingRanking/{playerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ⚠️ OS RANKINGS SEMANAIS (23/09/2026): uma subcolecao por semana, pelos tres jogos das Ilhas.
    // A regra e a MESMA dos rankings de sempre -- leitura livre pra quem esta logado, escrita
    // NEGADA a todos, inclusive ao dono: placar e publico, e uma linha no console poria qualquer
    // numero no topo. Quem grava sao as callables, pelo Admin SDK, que ignora estas regras.
    match /fishingRankingWeekly/{semanaId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /players/{playerId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
    match /rescueRankingWeekly/{semanaId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /players/{playerId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
    match /raceRankingWeekly/{semanaId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /players/{playerId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
    // ⚠️ A ARENA DA SEMANA (24/09/2026): aqui a subcolecao da semana E o proprio ranking -- ela
    // guarda o NIVEL de cada treinador, que e o que o top 10 ordena. A regra e a mesma dos outros
    // quatro (leitura livre pra quem esta logado, escrita NEGADA a todos, inclusive ao dono), e
    // aqui ela pesa como na Selecao: o que se grava nao e um recorde que so sobe por comparacao, e
    // um CONTADOR que o servidor incrementa -- uma linha no console poria nivel 99 no topo.
    // Nao ha colecao "de sempre": o adversario muda de especie toda semana, e nivel 8 contra a
    // Ninetales nao e nivel 8 contra o Dragonite.
    match /arenaRankingWeekly/{semanaId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /players/{playerId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
    // Ranking da Corrida: os dois tempos (individual e revezamento). Mesma regra do da pescaria --
    // tempo e placar publico, e escrita do cliente poria 0,01 s no topo. So a callable escreve.
    match /raceRanking/{playerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Ranking da Selecao (o aproveitamento contra a Luana). Mesma regra dos outros dois -- e aqui
    // ela pesa MAIS: o que se grava nao e um recorde que so sobe, e um CONTADOR de partidas e
    // vitorias. Escrita do cliente poria 999 vitorias e 0 derrotas.
    match /selecaoRanking/{playerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Ranking do Resgate: a maior pontuacao. Mesma regra dos outros tres -- e com ele o Resgate
    // ganhou a PRIMEIRA operacao de servidor dele: ate 21/09/2026 o modo era offline inteiro.
    match /rescueRanking/{playerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
